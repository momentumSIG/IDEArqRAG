<http://idearq.org/resource/article/960061> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/damia_ramis>,
        <http://idearq.org/resource/author/josep_antoni_alcover> ;
    dcterms:identifier "960061" ;
    dcterms:issued "2001"^^xsd:gYear ;
    dcterms:title "Revisiting the Earliest Human Presence in Mallorca, Western Mediterranean" ;
    ns1:abstract "A new date for the assumed first humans in Mallorca disagrees strongly with the earliest dating of them. New light on the first settlement of Mallorca comes from the discussion of dates and the review of the empirical evidence for that settlement. We conclude that human arrival on Mallorca must be situated in the 3rd millennium cal BC." ;
    ns1:doi "10.1017/s0079497x00001687" .


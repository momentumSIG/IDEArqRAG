<http://idearq.org/resource/article/960289> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/diana_vicente_checa>,
        <http://idearq.org/resource/author/m_a_victoria_pastor_sanchez> ;
    dcterms:identifier "960289" ;
    dcterms:isPartOf <http://idearq.org/resource/journal/1576-6454> ;
    dcterms:issued "2009"^^xsd:gYear ;
    dcterms:title "La Cueva Sepulcral Neolítica/Calcolítica de San Juan en Loarre (Huesca)" ;
    ns1:abstract "Este arti?culo resume la excavacio?n arqueolo?gica realizada en la cueva sepulcral de Loarre (Huesca) dentro de las actuaciones de urgencia del Servicio de Prevencio?n y Proteccio?n del Patrimonio Cultural de la Diputacio?n General de Arago?n. Se trata de una sepultura de cara?cter colectivo y acumulativo donde se recogieron restos de al menos 47 individuos, asi? como diversos materiales de su ajuar funerario. Tambie?n comprende el estudio de dichos materiales para su localizacio?n dentro de un horizonte Neoli?tico- Calcoli?tico." ;
    ns1:doi "10.26754/ojs_salduie/sald.200996599" ;
    ns1:issn "1576-6454" .


<http://idearq.org/resource/article/959840> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/francesc_xavier_oms>,
        <http://idearq.org/resource/author/itxaso_euba_rementeria>,
        <http://idearq.org/resource/author/juan_ignacio_morales_hidalgo>,
        <http://idearq.org/resource/author/marta_fontanals_i_torroja> ;
    dcterms:identifier "959840" ;

<http://idearq.org/resource/article/958386> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/ignacio_barandiaran_maestu>,
        <http://idearq.org/resource/author/joaquin_gonzalez_echegaray> ;

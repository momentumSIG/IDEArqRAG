    dcterms:issued "1990"^^xsd:gYear ;
    dcterms:title "Un Área Doméstica de la Edad del Bronce en el Poblado de El Acequión\" (Albacete)\"" ;
    ns1:issn "0210-3230" .

<http://idearq.org/resource/article/959829> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/maria_dolores_fernandez_posse> ;
    dcterms:identifier "959829" ;
    dcterms:issued "1979"^^xsd:gYear ;

<http://idearq.org/resource/article/960386> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/jorge_a_soler_diaz> ;
    dcterms:identifier "960386" ;
    dcterms:issued "2006"^^xsd:gYear ;
    dcterms:title "La Ocupación Prehistórica de la Illeta dels Banyets (El Campello, Alicante)" ;
    ns1:abstract "Se ofrecen los resultados de las actuaciones arqueologicas realizadas entre los anos 2000 y 2001 en este importante yacimiento arqueologico alicantino con motivo de su puesta en valor y musealizacion. Las excavaciones, cuyos resultados se detallan en esta obra, han permitido la revision y actualizacion de los datos referentes a la ocupacion prehistorica de este asentamiento, obtenidos durante los importantes trabajos llevados a cabo en la decada de los setenta y ochenta por E. Llobregat Conesa y que permanecian sustancialmente ineditos." ;
    ns1:uri "https://marqalicante.com/contenido/publicaciones/pub_61.pdf" .


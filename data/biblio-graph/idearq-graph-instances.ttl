<http://idearq.org/resource/article/960103> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/gema_garrido_resino>,
        <http://idearq.org/resource/author/jaime_perera_rodriguez>,
        <http://idearq.org/resource/author/javier_perez_lopez_trivino>,
        <http://idearq.org/resource/author/juan_manuel_rojas_rodriguez_malo> ;

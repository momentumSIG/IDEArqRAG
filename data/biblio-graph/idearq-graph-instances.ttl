    dcterms:title "14C carbonate dating and the age of post-Talayotic lime burials in Mallorca" ;
    ns1:doi "10.1038/255475a0" .

<http://idearq.org/resource/article/960075> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/william_h_waldren> ;
    dcterms:identifier "960075" ;
    dcterms:issued "1966"^^xsd:gYear ;
    dcterms:title "Los materiales encontrados en la Cueva de Son Muleta" .

<http://idearq.org/resource/article/960076> a ns1:AcademicArticle ;

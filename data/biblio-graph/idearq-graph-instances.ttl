<http://idearq.org/resource/article/960213> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/fidel_mendez_fernandez> ;
    dcterms:identifier "960213" ;
    dcterms:isPartOf <http://idearq.org/resource/journal/0082-5638> ;
    dcterms:issued "1994"^^xsd:gYear ;
    dcterms:title "La Domesticación del Paisaje durante la Edad del Bronce Gallego" ;
    ns1:abstract "Partiendo del estudio de un conjunto de hábitats de una zona de Galicia se define un nuevo tipo de yacimiento habitacional. Esta definición sirve de base para una revisión del paisaje social de la Edad del Bronce en el Noroeste, en la cual se realizan algunas consideraciones sobre fenómenos que no se incluyen en el mundo de los hábitats (enterramientos y grabados rupestres), pero que, evidentemente, contribuyen a formar el conjunto del paisaje social." ;
    ns1:doi "10.3989/tp.1994.v51.i1.465" ;
    ns1:issn "0082-5638" .


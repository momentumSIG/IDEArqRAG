<http://idearq.org/resource/article/959759> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/a_moyano_jaime>,
        <http://idearq.org/resource/author/b_bartolome_arquillo>,
        <http://idearq.org/resource/author/carmen_gutierrez_saez>,

<http://idearq.org/resource/article/960409> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/a_a_huet_b_goncalves>,
        <http://idearq.org/resource/author/domingos_j_da_cruz>,
        <http://idearq.org/resource/author/raquel_vilaca> ;
    dcterms:identifier "960409" ;
    dcterms:isPartOf <http://idearq.org/resource/journal/0084-9189> ;
    dcterms:issued "1999"^^xsd:gYear ;
    dcterms:title "A Necrópole de Tanchoal Dos Patudos (Alpiarça, Santarém)" ;
    ns1:abstract "We are publishing the radiocarbon dates obtained from the organic remains found in one of the vases from the cemetery of Tanchoal (Alpiarça, Ribatejo), which was identified at the beginning of last century.The results indicate a chronology of the Late Bronze Age, between mid XI century b. C. and the beginning of the IX century b. C. By the way, some considerations are being construed upon the cremation rituals, burial context, goods, etc." ;
    ns1:doi "10.14195/1647-8657_38_1" ;
    ns1:issn "0084-9189" .

<http://idearq.org/resource/article/960412> a ns1:AcademicArticle ;

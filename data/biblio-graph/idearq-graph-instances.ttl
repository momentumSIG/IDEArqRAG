<http://idearq.org/resource/article/960166> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/alberto_jose_lorrio_alvarado>,
        <http://idearq.org/resource/author/ignacio_montero_ruiz>,
        <http://idearq.org/resource/author/maria_dolores_sanchez_de_prado>,
        <http://idearq.org/resource/author/maria_paz_de_miguel_ibanez>,
        <http://idearq.org/resource/author/mariano_torres_ortiz> ;
    dcterms:identifier "960166" ;
    dcterms:issued "2008"^^xsd:gYear ;
    dcterms:title "Qurénima: El Bronce Final del Sureste de la Península Ibérica" ;
    ns1:abstract "Este nuevo trabajo de profesor Alberto J. Lorrio consigue que el llamado Grupo de Qurenima pase de ser un conjunto de sepulturas excavadas por los hermanos Enrique y Luis Siret a fines del siglo XIX -de interpretacion incierta y discutida- a constituir uno de los grupos culturales mejor definidos y fechados del Mediodia de la Peninsula Iberica, aportando mucho mas de lo que su titulo hace suponer." ;
    ns1:uri "https://dialnet.unirioja.es/descarga/articulo/3990343.pdf" .


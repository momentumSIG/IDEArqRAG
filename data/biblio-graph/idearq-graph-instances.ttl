    dcterms:issued "2001"^^xsd:gYear ;
    dcterms:title "Resultados Preliminares de la Excavación Arqueológica de Urgencia en el Poblado Prehistórico del Espolón de Tragalamocha, Nerja, 1998: Autovía del Mediterráneo Tramo Frigiliana-Maro" .

<http://idearq.org/resource/article/959833> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/juan_fernandez_ruiz> ;
    dcterms:identifier "959833" ;
    dcterms:issued "2004"^^xsd:gYear ;

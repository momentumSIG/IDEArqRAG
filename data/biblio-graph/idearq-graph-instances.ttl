    dcterms:issued "2005"^^xsd:gYear ;
    dcterms:title "El Poblamiento en el Valle Medio del Ebro durante la Prehistoria Reciente: Zonas y Procesos" ;
    ns1:issn "1131-883X" ;
    ns1:uri "https://www.rap.udl.cat/export/sites/Arqueologia/ca/.galleries/Documents/15.5-Picazo.pdf" .

<http://idearq.org/resource/article/960304> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/jesus_vicente_picazo_millan>,
        <http://idearq.org/resource/author/jose_maria_rodanes_vicente> ;
    dcterms:identifier "960304" ;
    dcterms:issued "2009"^^xsd:gYear ;
    dcterms:title "Los Poblados del Bronce Final y Primera Edad del Hierro, Cabezo de la Cruz, La Muela, Zaragoza" ;
    ns1:abstract "Estudio sobre el yacimiento conocido como Cabezo de la Cruz, uno de los principales referentes para la Primera Edad del Hierro en el valle medio del Ebro y de gran riqueza arqueologica. Esta publicacion se remonta a su descubrimiento en 1971 y aborda la historia de las investigaciones. Los capitulos siguientes se dedican a la metodologia y las fases de la excavacion, la estratigrafia general, los estudios paleoeconomicos y paleoambientales, sobre el poblado del Bronce Final y los poblados de la Primera Edad del Hierro, y por ultimo la ocupacion andalusi del Cabezo." ;
    ns1:uri "https://www.researchgate.net/publication/267097226_Los_poblados_del_Bronce_Final_y_Primera_Edad_del_Hierro_Cabezo_de_la_Cruz_La_Muela_Zaragoza" .


    dcterms:identifier "960299" ;
    dcterms:issued "2015"^^xsd:gYear ;
    dcterms:title "Pautas Funerarias y Demográficas de la Edad del Bronce en la Cuenca Media y Alta del Tajo" ;
    ns1:uri "https://www.academia.edu/20416106/Pautas_funerarias_y_demogr%C3%A1ficas_de_la_Edad_de_Bronce_en_la_cuenca_media_y_alta_del_Tajo" .

<http://idearq.org/resource/article/960301> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/diego_piay_augusto>,
        <http://idearq.org/resource/author/juan_a_cano_pan>,
        <http://idearq.org/resource/author/juan_naveiro_lopez> ;
    dcterms:identifier "960301" ;
    dcterms:isPartOf <http://idearq.org/resource/journal/0514-7336> ;
    dcterms:issued "2015"^^xsd:gYear ;
    dcterms:title "La Construcción Anular y el enclos de Ventosiños (Coeses, Lugo): Estudio Preliminar de un Conjunto del Bronce Final" ;
    ns1:abstract "During the construction works of the a-54 from Lugo to Santiago de Compostela highway, a structure was documented in Ventosiños place, in the parish of Coeses (Lugo), of a kind so far unknown in the context of Galician Prehistory. It was a ring-shaped construction, built with sediment and stone elements, enclosing an inner area in which various pits with lithic and ceramic remains and in situ placed vessels inside were found. In addition, North of this structure, a fence or enclos was located, enveloping an even larger area, in which impressions of diferent morphologies and pits were found. Some of them had perforated disks and in situ placed vessels inside.Present analysis is intended to briefly summarize the preliminary data obtained from the archaeological works carried out in the whole ensemble, since the site is still under study." ;
    ns1:doi "10.14201/zephyrus2015765776" ;
    ns1:issn "0514-7336" .

<http://idearq.org/resource/article/960303> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/jesus_v_picazo> ;
    dcterms:identifier "960303" ;

<http://idearq.org/resource/article/960021> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/bartomeu_salva_simonet>,
        <http://idearq.org/resource/author/manuel_antonio_calvo_trias>,
        <http://idearq.org/resource/author/victor_m_guerrero_ayuso> ;

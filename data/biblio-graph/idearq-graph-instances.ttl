<http://idearq.org/resource/article/958552> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/staso_forenbaher> ;
    dcterms:identifier "958552" ;
    dcterms:issued "2007"^^xsd:gYear ;
    dcterms:title "Lithic Production at Casas de Baixo and the Prismatic Blades of the Portuguese Neolithic" ;
    ns1:abstract "Prismatic blades and blade-based tools often constitute a substantial part of lithic assemblages from Portuguese Late Neolithic and Copper Age sites. At Casas de Baixo, a flint source and lithic production site near Vila Nova de Ourem, cores were prepared from which such blades were extracted. Evidence from this site, combined with evidence from other roughly contemporaneous sites in west central Portugal, hint at the possibility that craft specializats were involved in their production." ;
    ns1:uri "https://dialnet.unirioja.es/descarga/articulo/5010156.pdf" .


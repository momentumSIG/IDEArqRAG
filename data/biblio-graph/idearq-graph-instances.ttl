        <http://idearq.org/resource/author/j_s_mestres> ;
    dcterms:identifier "960222" ;
    dcterms:isPartOf <http://idearq.org/resource/journal/0033-8222> ;
    dcterms:issued "1991"^^xsd:gYear ;
    dcterms:title "The Radiocarbon Laboratory at the University of Barcelona" ;
    ns1:abstract "In 1983, the University of Barcelona, the Institut d'Estudis Catalans and the Department of Culture of the Generalitat de Catalunya agreed to establish a laboratory for radiocarbon measurement at the Analytical Chemistry Department of the University of Barcelona. The liquid scintillation technique was chosen for radiocarbon counting. The counting laboratory is in the basement of a six-story building." ;
    ns1:doi "10.1017/s0033822200013187" ;
    ns1:issn "0033-8222" .


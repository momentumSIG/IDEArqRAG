<http://idearq.org/resource/article/959725> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/genaro_alvarez_garcia>,
        <http://idearq.org/resource/author/joaquin_rodriguez_vidal>,
        <http://idearq.org/resource/author/jose_antonio_caro_gomez> ;

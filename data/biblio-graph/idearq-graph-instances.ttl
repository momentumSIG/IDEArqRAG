<http://idearq.org/resource/article/959523> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/jesus_sesma_sesma>,
        <http://idearq.org/resource/author/maria_luisa_garcia_garcia>,
        <http://idearq.org/resource/author/maria_teresa_andres_ruperez> ;

<http://idearq.org/resource/article/960221> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/gemma_rauret>,
        <http://idearq.org/resource/author/j_f_garcia>,
        <http://idearq.org/resource/author/j_s_mestres> ;
    dcterms:identifier "960221" ;
    dcterms:isPartOf <http://idearq.org/resource/journal/0033-8222> ;
    dcterms:issued "1991"^^xsd:gYear ;
    dcterms:title "University of Barcelona Radiocarbon Dates I" ;
    ns1:abstract "The Radiocarbon Laboratory at the University of Barcelona began its serial measurements in 1985. The following list contains dates obtained between 1985 and 1987. Both archaeological and geological samples were dated. The measurement technique we use is liquid scintillation counting of benzene. A previous paper (Mestres, García & Rauret 1991) describes sample pretreatment, synthesis and counting protocols and equipment." ;
    ns1:doi "10.1017/s0033822200040376" ;
    ns1:issn "0033-8222" .

<http://idearq.org/resource/article/960222> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/gemma_rauret>,

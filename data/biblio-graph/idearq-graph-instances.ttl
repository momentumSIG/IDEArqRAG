<http://idearq.org/resource/article/959825> a ns1:AcademicArticle ;
    dcterms:creator <http://idearq.org/resource/author/aj_legge>,
        <http://idearq.org/resource/author/g_moreno_lopez>,
        <http://idearq.org/resource/author/rj_harrison> ;
    dcterms:identifier "959825" ;
